{
  "name": "cullit",
  "version": "2.10.0",
  "private": true,
  "description": "Cull the noise from your releases. AI-powered release notes.",
  "author": "Cullit <matt@cullit.io>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mttaylor/cullit-oss"
  },
  "keywords": [
    "release-notes",
    "changelog",
    "ai",
    "github-action",
    "automation",
    "devops"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build && pnpm build:action",
    "build:action": "tsup src/action.ts --format cjs --out-dir dist --no-splitting --target node22",
    "hooks:install": "git config core.hooksPath .githooks",
    "lockfile:check": "pnpm install --frozen-lockfile",
    "lockfile:sync": "pnpm install --no-frozen-lockfile",
    "bump-version": "node scripts/bump-version.mjs",
    "test": "vitest run",
    "dev": "pnpm --filter cullit dev",
    "lint": "eslint packages/ --max-warnings=250",
    "cullit": "node packages/cli/dist/index.js"
  },
  "dependencies": {
    "@cullit/config": "workspace:*",
    "@cullit/core": "workspace:*",
    "@cullit/pro": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  }
}
